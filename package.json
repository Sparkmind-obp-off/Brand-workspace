{
  "name": "brand-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=brand-workspace-production --local --ip 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply brand-workspace-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply brand-workspace-production --remote"
  },
  "dependencies": {
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
